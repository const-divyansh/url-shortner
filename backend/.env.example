# Copy to .env and adjust. .env is gitignored - never commit real credentials.
# docker-compose reads this file automatically; export these vars too when
# running `mvn spring-boot:run` outside Docker.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=urlshortener
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_PORT=8080
LOG_LEVEL=INFO

# Public origin used to build returned short URLs.
APP_BASE_URL=http://localhost:8080

# Short-code strategy: base62-random | hash-url
SHORTCODE_STRATEGY=base62-random

# Secret mixed into client-IP hashes. Generate a real random value per environment:
#   openssl rand -hex 32
# Never commit the real value, and never store it in the database - keeping it next to
# the hashes it protects would defeat the purpose.
ANALYTICS_IP_PEPPER=dev-only-not-a-secret

# Comma-separated proxy addresses whose X-Forwarded-For header may be believed.
# Leave empty unless running behind a proxy you control.
#
# This matters MORE for rate limiting than for analytics: if a client could set its
# own address it would present a new one per request and never be limited. The
# opposite mistake is just as bad - deploying behind a proxy WITHOUT listing it here
# collapses every caller onto the proxy's address, turning a per-IP budget into a
# single global one shared by all users.
ANALYTICS_TRUSTED_PROXIES=

# --- Rate limiting -----------------------------------------------------------
# Per-IP request budgets, counted in Redis against a hashed client address.
#
# If Redis is unreachable the limiter FAILS OPEN: requests are allowed and a warning
# is logged, because a limiter outage must never become a service outage.
#
# Set RATELIMIT_ENABLED=false to remove limiting from the request path entirely (a
# no-op limiter is wired in, so no Redis calls are made at all).
#
# To try it by hand, set RATELIMIT_CREATE_LIMIT to something small like 3, restart,
# and create four links - the fourth returns 429 with a Retry-After header.
RATELIMIT_ENABLED=true
RATELIMIT_CREATE_LIMIT=10
RATELIMIT_CREATE_WINDOW=1m
RATELIMIT_REDIRECT_LIMIT=300
RATELIMIT_REDIRECT_WINDOW=1m

# Cross-origin allow-list for the frontend dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth ("Sign in with Google"). Create an OAuth 2.0 Client ID in Google Cloud
# Console (APIs & Services > Credentials), type "Web application", with
# GOOGLE_OAUTH_REDIRECT_URI added under "Authorized redirect URIs". Never commit real
# values - guest login still works with these left blank.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Where the browser lands after a successful Google login (the frontend dev server).
GOOGLE_OAUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/
