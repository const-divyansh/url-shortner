# Copy to .env and adjust. .env is gitignored.
#
# Only VITE_-prefixed variables reach the browser bundle. Everything here is
# therefore PUBLIC - readable by anyone who loads the page. Never put a secret
# in this file or in .env.

# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:8080

# Click-history rows per page on the analytics screen. The API caps this
# server-side, so a larger value simply returns the cap.
VITE_ANALYTICS_PAGE_SIZE=20

# How long the "copied" confirmation stays visible, in milliseconds.
VITE_COPY_FEEDBACK_MS=2000
